# Optional local overrides. Copy this file to .env before running npm start.
N8N_HOST=localhost
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_USER_FOLDER=.data
# Change this too if another local n8n instance already uses the default task-broker port.
N8N_RUNNERS_BROKER_PORT=5679

# Keep the classroom instance quiet and local by default.
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# Do not put AI provider API keys here. Add them through n8n Credentials.
