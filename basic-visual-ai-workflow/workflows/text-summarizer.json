      "webhookId": "2ef58a5a-8367-45f5-a80e-4aa5f606b714"
    },
    {
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "document",
        "destinationKey": "content",
        "options": {
          "encoding": "utf8",
          "stripBOM": true
        }
      },
      "id": "f527458e-90eb-4cc4-af66-d7332ac3c2f0",
      "name": "Extract Document Text",
      "type": "n8n-nodes-base.extractFromFile",
