{
  "id": "text-summarizer-2325",
  "name": "Text File Summarizer",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Summarize a text document",
        "formDescription": "Upload one plain-text or Markdown document.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Document",
              "fieldName": "document",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".txt,.md",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "buttonLabel": "Summarize"
        }
      },
      "id": "911b7331-8273-48f7-a046-ca40132e759c",
      "name": "Upload Document",
      "type": "n8n-nodes-base.formTrigger",
